# Replit agent artifacts (legacy)
# Keep the agent configuration tracked - it must travel with the repo. Claude Code reads
# .claude/skills and .claude/agents; worktrees live under .claude/worktrees and must never be
# committed, which is why this is a denylist with narrow negations rather than the reverse.
.claude/*
!.claude/skills/
!.claude/agents/
.config/
.agent-runs/

# Playwright MCP snapshots
.playwright-mcp/

# Test output
test-results/
**/coverage/

supabase/.temp/ 

# Playwright saved sessions (live tokens) — tests/helpers/admin-auth.ts
.auth/
