# Supabase project URL for running integration tests against Postgres
SUPABASE_URL=

# Supabase anon/public key for unauthenticated test requests
SUPABASE_ANON_KEY=

# Supabase service role key for admin operations and RLS bypass in tests
SUPABASE_SERVICE_ROLE_KEY=

# Session encryption secret (must be at least 32 characters long)
SESSION_SECRET=

# Base URL of the running API server (defaults to http://localhost:5000 if unset)
API_URL=
